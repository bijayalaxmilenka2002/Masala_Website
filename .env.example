# ============================================================================
# SUBHADARSHINI SPICES - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual Supabase credentials.
#
# Where to find your Supabase credentials:
# 1. Sign in to https://supabase.com/dashboard
# 2. Select your project (or create one for free)
# 3. Go to "Project Settings" (gear icon) -> "API"
# 4. Copy "Project URL" into SUPABASE_URL
# 5. Copy "anon / public" key into SUPABASE_ANON_KEY
# 6. Copy "service_role" secret key into SUPABASE_SERVICE_ROLE_KEY (keep private!)
# ============================================================================

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Supabase Service Role Secret Key (Required for backend Owner Portal access)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Owner Portal Credentials (for /owner-login.html)
OWNER_USER=admin
OWNER_PASS=Subhadarshini@2026

# Secure HMAC Secret for stateless owner session tokens
AUTH_SECRET=subhadarshini-spices-secure-hmac-key-2026

# Local Web Server Port
PORT=3000
